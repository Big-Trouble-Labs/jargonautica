# Point this at the folder holding the term notes. Every build copies them in first.
# Leave it unset on a build server: whatever is in content/ai is used as-is.
VAULT_DIR="/path/to/your/obsidian/vault/AI Terminology"

# The public half of a Cloudflare Turnstile key, used by the submission forms.
# Normally unset: the real one is committed in src/data/site.json, because a site
# key appears in the page source anyway. Set this to use the dummy testing keys.
PUBLIC_TURNSTILE_SITE_KEY=""
