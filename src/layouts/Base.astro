---
const { title, description, wide = false, ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const full = title === 'Jargonautica' ? title : `${title} · Jargonautica`;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical.href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0F6B5F" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Jargonautica" />
  <meta property="og:title" content={full} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('jn-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <style is:global>
    :root {
      --ground:#F1F4F2; --surface:#FBFCFB; --surface-2:#E7ECE9;
      --ink:#16211D; --ink-2:#47554F; --ink-3:#6F7D77;
      --rule:#CFD8D4; --accent:#0F6B5F; --accent-soft:#DCEBE7;
      --warm:#9C6316; --warm-soft:#F3E7D4;
      --shadow:0 1px 2px rgba(22,33,29,.06),0 8px 24px rgba(22,33,29,.10);
      --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
      --body:"Source Serif 4",Georgia,"Times New Roman",serif;
      --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --ground:#0D1513; --surface:#14201C; --surface-2:#1C2A26;
        --ink:#E4EBE8; --ink-2:#A8B7B1; --ink-3:#7C8C86;
        --rule:#2A3A35; --accent:#5AD3BA; --accent-soft:#14322C;
        --warm:#E0A44C; --warm-soft:#33270F;
        --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.45);
      }
    }
    :root[data-theme="dark"] {
      --ground:#0D1513; --surface:#14201C; --surface-2:#1C2A26;
      --ink:#E4EBE8; --ink-2:#A8B7B1; --ink-3:#7C8C86;
      --rule:#2A3A35; --accent:#5AD3BA; --accent-soft:#14322C;
      --warm:#E0A44C; --warm-soft:#33270F;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.45);
    }

    *{box-sizing:border-box}
    body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.62;-webkit-font-smoothing:antialiased}
    .wrap{max-width:46rem;margin:0 auto;padding:0 1.5rem 4rem}
    .wrap.wide{max-width:76rem}
    a{color:var(--accent)}
    :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
    h1{font-family:var(--display);font-weight:700;font-size:clamp(2rem,5vw,2.75rem);line-height:1.05;letter-spacing:-.02em;margin:0 0 .5rem;text-wrap:balance}
    h2{font-family:var(--display);font-weight:600;font-size:1.0625rem;margin:2.25rem 0 .5rem}
    .lede{font-size:1.1875rem;line-height:1.55;color:var(--ink-2)}
    .count{font-family:var(--mono);font-size:.75rem;color:var(--ink-3)}

    header.site{border-bottom:1px solid var(--rule);margin-bottom:2.5rem;background:var(--ground);position:sticky;top:0;z-index:40}
    header.site .bar{max-width:76rem;margin:0 auto;padding:.6rem 1.5rem;display:flex;align-items:center;gap:1rem}
    .brand{display:flex;align-items:center;gap:.5rem;font-family:var(--display);font-weight:700;font-size:1.0625rem;color:var(--ink);letter-spacing:-.01em;text-decoration:none;flex:0 0 auto}
    .brand svg{display:block;width:21px;height:21px;color:var(--accent)}
    nav.site{display:flex;gap:.9rem;margin-left:auto;align-items:center}
    nav.site a{font-family:var(--mono);font-size:.8125rem;text-decoration:none;color:var(--ink-3);white-space:nowrap}
    nav.site a:hover,nav.site a[aria-current="page"]{color:var(--accent)}
    .iconbtn{font-family:var(--mono);font-size:.8125rem;background:var(--surface);border:1px solid var(--rule);color:var(--ink-3);border-radius:3px;padding:.28rem .5rem;cursor:pointer;display:flex;align-items:center;gap:.4rem;line-height:1.5}
    .iconbtn:hover{color:var(--accent);border-color:var(--accent)}
    .iconbtn kbd{font-family:var(--mono);font-size:.6875rem;border:1px solid var(--rule);border-radius:2px;padding:0 .25rem;color:var(--ink-3)}
    @media (max-width:760px){
      nav.site a.hide-sm{display:none}
      .iconbtn kbd{display:none}
      nav.site{gap:.7rem}
    }
    @media (max-width:560px){
      .wordmark,.iconbtn .slabel{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
      header.site .bar{padding:.55rem 1rem;gap:.6rem}
      nav.site{gap:.55rem}
      .wrap{padding-left:1.15rem;padding-right:1.15rem}
    }

    .searchveil{position:fixed;inset:0;z-index:60;background:rgba(13,21,19,.5);display:none;padding:6vh 1rem 1rem}
    .searchveil[data-open]{display:block}
    .searchbox{max-width:38rem;margin:0 auto;background:var(--surface);border:1px solid var(--rule);border-radius:6px;box-shadow:var(--shadow);overflow:hidden}
    .searchbox input{width:100%;border:0;border-bottom:1px solid var(--rule);background:transparent;color:var(--ink);font-family:var(--display);font-weight:600;font-size:1.125rem;padding:1rem 1.1rem;outline:none}
    .searchbox input::placeholder{color:var(--ink-3);font-weight:400}
    .results{list-style:none;margin:0;padding:.35rem;max-height:56vh;overflow-y:auto}
    .results li a{display:block;padding:.5rem .75rem;border-radius:4px;text-decoration:none;color:var(--ink)}
    .results li a small{display:block;color:var(--ink-3);font-size:.8125rem;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .results li a .sec{display:block;font-family:var(--mono);font-size:.6875rem;color:var(--accent);text-transform:uppercase;letter-spacing:.08em}
    .results li a .name{font-family:var(--display);font-weight:600}
    .results li[aria-selected="true"] a,.results li a:hover{background:var(--accent-soft)}
    .results .empty{padding:1rem .75rem;color:var(--ink-3);font-size:.9375rem}
    .searchfoot{border-top:1px solid var(--rule);padding:.5rem .85rem;font-family:var(--mono);font-size:.6875rem;color:var(--ink-3);display:flex;gap:1rem;flex-wrap:wrap}

    .chip{display:inline-block;font-family:var(--mono);font-size:.6875rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);background:var(--accent-soft);padding:.25rem .5rem;border-radius:2px;text-decoration:none}
    .aliases{font-family:var(--mono);font-size:.8125rem;color:var(--ink-3);margin:0 0 1.75rem}
    article h2{font-family:var(--display);font-weight:600;font-size:1rem;color:var(--ink-3);letter-spacing:.02em;margin:2.5rem 0 .5rem}
    article hr{border:0;border-top:1px solid var(--rule);margin:2.5rem 0 1.25rem}
    article > p:first-child{font-size:1.1875rem;line-height:1.55}
    details.technical{border:1px solid var(--rule);background:var(--surface);padding:.85rem 1.1rem;margin:1.75rem 0;border-radius:3px}
    details.technical[open]{padding-bottom:.4rem}
    .technical-body{padding-top:.5rem;color:var(--ink-2);font-size:.9875rem}
    .technical-body p:last-child{margin-bottom:.5rem}
    summary{font-family:var(--display);font-weight:600;cursor:pointer;color:var(--ink-2)}
    summary:hover{color:var(--accent)}
    .related{list-style:none;padding:0;margin:.5rem 0 0;display:grid;gap:.5rem}
    .related li{background:var(--surface);border:1px solid var(--rule);padding:.6rem .8rem;font-size:.9375rem;border-radius:3px}
    footer.term{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--rule);font-family:var(--mono);font-size:.75rem;color:var(--ink-3)}
    footer.term p{margin:.2rem 0}
    .pager{display:flex;gap:1rem;justify-content:space-between;margin-top:2.5rem;padding-top:1.25rem;border-top:1px solid var(--rule);font-size:.9375rem}
    .pager a{text-decoration:none;max-width:47%}
    .pager span{display:block;font-family:var(--mono);font-size:.6875rem;color:var(--ink-3);text-transform:uppercase;letter-spacing:.08em}
    .pager .next{text-align:right;margin-left:auto}

    .sections{display:grid;gap:2rem}
    .sections ul{list-style:none;padding:0;margin:.4rem 0 0;display:grid;gap:.15rem}
    .sections li a{text-decoration:none}
    .sections li span{color:var(--ink-3);font-size:.9375rem}
    .sections section{scroll-margin-top:5rem}
    .jump{display:flex;flex-wrap:wrap;gap:.35rem;margin:1.5rem 0 2.5rem;padding:0;list-style:none}
    .jump a{font-family:var(--mono);font-size:.75rem;text-decoration:none;border:1px solid var(--rule);background:var(--surface);padding:.25rem .5rem;border-radius:3px;color:var(--ink-2)}
    .jump a:hover{border-color:var(--accent);color:var(--accent)}

    footer.site{border-top:1px solid var(--rule);margin-top:4rem;background:var(--surface-2)}
    footer.site .inner{max-width:76rem;margin:0 auto;padding:2rem 1.5rem 3rem;display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-between;font-size:.875rem;color:var(--ink-3)}
    footer.site a{color:var(--ink-2)}
    footer.site .cols{display:flex;gap:2.5rem;flex-wrap:wrap}
    footer.site ul{list-style:none;margin:.3rem 0 0;padding:0;display:grid;gap:.2rem}
    footer.site h3{font-family:var(--mono);font-size:.6875rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3);margin:0;font-weight:500}

    /* submission forms */
    form#submit-form{display:grid;gap:1.25rem;margin:1.75rem 0 1rem;max-width:38rem}
    .field{display:grid;gap:.25rem}
    .field label,.credit legend{font-family:var(--display);font-weight:600;font-size:.9375rem}
    .field input,.field textarea,.field select{font-family:var(--body);font-size:1rem;padding:.55rem .7rem;border:1px solid var(--rule);border-radius:3px;background:var(--surface);color:var(--ink);width:100%}
    .field textarea{resize:vertical;line-height:1.5}
    .field input:focus,.field textarea:focus,.field select:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--accent-soft)}
    .field small{color:var(--ink-3);font-size:.8125rem}
    .field.bad input,.field.bad textarea{border-color:var(--warm)}
    .field.fixed input{background:var(--surface-2);color:var(--ink-2);font-family:var(--display);font-weight:600}
    .opt{font-family:var(--mono);font-weight:400;font-size:.6875rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3)}
    fieldset.credit{border:1px solid var(--rule);border-radius:3px;padding:.9rem 1rem 1.1rem;margin:0;display:grid;gap:.75rem;background:var(--surface)}
    fieldset.credit .small{color:var(--ink-3);font-size:.875rem;margin:0}
    fieldset.credit .row{display:grid;gap:.75rem;grid-template-columns:1fr 1fr}
    @media (max-width:520px){fieldset.credit .row{grid-template-columns:1fr}}
    .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
    .actions{display:flex;align-items:center;gap:.9rem;flex-wrap:wrap;margin:0}
    .btn{display:inline-block;font-family:var(--display);font-weight:600;font-size:.9375rem;padding:.6rem 1.1rem;border-radius:3px;background:var(--accent);color:var(--ground);border:1px solid var(--accent);cursor:pointer;text-decoration:none}
    .btn.ghost{background:transparent;color:var(--accent)}
    .btn:hover{opacity:.88}
    .btn[disabled]{opacity:.55;cursor:progress}
    .msg{font-size:.9375rem;max-width:24rem}
    .msg.ok{color:var(--accent)}
    .msg.err{color:var(--warm)}
    .elsewhere{color:var(--ink-3);font-size:.9375rem;margin:0 0 1rem}

    @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
  </style>
</head>
<body>
  <header class="site">
    <div class="bar">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12 3.6 13.9 10.1 20.4 12 13.9 13.9 12 20.4 10.1 13.9 3.6 12 10.1 10.1Z" fill="currentColor"/>
        </svg>
        <span class="wordmark">Jargonautica</span>
      </a>
      <nav class="site">
        <a href="/ai/">Glossary</a>
        <a href="/ai/graph/">Graph</a>
        <a class="hide-sm" href="/suggest/">Suggest</a>
        <a class="hide-sm" href="/about/">About</a>
        <button class="iconbtn" id="search-open" type="button" aria-label="Search the glossary">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.6"/>
            <path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="slabel">Search</span> <kbd>/</kbd>
        </button>
        <button class="iconbtn" id="theme-toggle" type="button" aria-label="Switch between light and dark">
          <span id="theme-icon" aria-hidden="true">&#9680;</span>
        </button>
      </nav>
    </div>
  </header>

  <main class:list={["wrap", wide && "wide"]}><slot /></main>

  <footer class="site">
    <div class="inner">
      <div>
        <strong style="font-family:var(--display);color:var(--ink)">Jargonautica</strong><br />
        Jargon, explained twice.<br />
        A <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener">CC BY-SA 4.0</a> glossary from Big Trouble Labs.
      </div>
      <div class="cols">
        <div>
          <h3>Read</h3>
          <ul>
            <li><a href="/ai/">AI glossary</a></li>
            <li><a href="/ai/graph/">The graph</a></li>
          </ul>
        </div>
        <div>
          <h3>Take part</h3>
          <ul>
            <li><a href="/suggest/">Suggest a term</a></li>
            <li><a href="/about/">About and licence</a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>

  <div class="searchveil" id="search-veil" role="dialog" aria-modal="true" aria-label="Search the glossary">
    <div class="searchbox">
      <input id="search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Search the glossary" aria-controls="search-results" />
      <ul class="results" id="search-results"></ul>
      <div class="searchfoot"><span>up and down to move</span><span>enter to open</span><span>esc to close</span></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var icon = document.getElementById('theme-icon');
      function current() {
        var t = root.getAttribute('data-theme');
        if (t) return t;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function paint() { if (icon) icon.textContent = current() === 'dark' ? '☾' : '☀'; }
      paint();
      var tt = document.getElementById('theme-toggle');
      if (tt) tt.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('jn-theme', next); } catch (e) {}
        paint();
      });

      var veil = document.getElementById('search-veil');
      var input = document.getElementById('search-input');
      var list = document.getElementById('search-results');
      var opener = document.getElementById('search-open');
      var index = null, loading = false, sel = 0, hits = [];
      var PROMPT = '<li class="empty">Type a term, or part of one. Nicknames and abbreviations work too.</li>';

      function load() {
        if (index || loading) return;
        loading = true;
        fetch('/search-index.json')
          .then(function (r) { return r.json(); })
          .then(function (d) { index = d; loading = false; run(); })
          .catch(function () {
            loading = false;
            list.innerHTML = '<li class="empty">Search could not load. The <a href="/ai/">glossary list</a> still works.</li>';
          });
      }

      function score(item, q) {
        var t = item.t.toLowerCase();
        if (t === q) return 0;
        if (t.indexOf(q) === 0) return 1;
        for (var i = 0; i < item.a.length; i++) {
          var a = item.a[i].toLowerCase();
          if (a === q) return 2;
          if (a.indexOf(q) === 0) return 3;
        }
        if (t.indexOf(q) > -1) return 4;
        for (var j = 0; j < item.a.length; j++) if (item.a[j].toLowerCase().indexOf(q) > -1) return 5;
        if (item.d.toLowerCase().indexOf(q) > -1) return 6;
        return -1;
      }

      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      function run() {
        if (!index) return;
        var q = input.value.trim().toLowerCase();
        if (!q) { hits = []; list.innerHTML = PROMPT; return; }
        var scored = [];
        for (var i = 0; i < index.length; i++) {
          var s = score(index[i], q);
          if (s > -1) scored.push([s, index[i].t.length, index[i]]);
        }
        scored.sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; });
        hits = scored.slice(0, 12).map(function (x) { return x[2]; });
        sel = 0;
        if (!hits.length) {
          list.innerHTML = '<li class="empty">Nothing matches that. <a href="/suggest/">Suggest it as a new term</a>.</li>';
          return;
        }
        list.innerHTML = hits.map(function (h, n) {
          return '<li role="option" aria-selected="' + (n === 0) + '"><a href="/ai/' + h.s + '/">' +
            '<span class="sec">' + esc(h.c) + '</span>' +
            '<span class="name">' + esc(h.t) + '</span>' +
            '<small>' + esc(h.d) + '</small></a></li>';
        }).join('');
      }

      function move(step) {
        if (!hits.length) return;
        sel = (sel + step + hits.length) % hits.length;
        var items = list.querySelectorAll('li');
        for (var i = 0; i < items.length; i++) items[i].setAttribute('aria-selected', i === sel);
        if (items[sel]) items[sel].scrollIntoView({ block: 'nearest' });
      }

      function show() {
        veil.setAttribute('data-open', '');
        input.value = '';
        list.innerHTML = PROMPT;
        input.focus();
        load();
      }
      function hide() { veil.removeAttribute('data-open'); }

      if (opener) opener.addEventListener('click', show);
      veil.addEventListener('click', function (e) { if (e.target === veil) hide(); });
      input.addEventListener('input', run);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter' && hits[sel]) { e.preventDefault(); location.href = '/ai/' + hits[sel].s + '/'; }
        else if (e.key === 'Escape') hide();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { hide(); return; }
        if (veil.hasAttribute('data-open')) return;
        var tag = (e.target.tagName || '').toLowerCase();
        if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return;
        if (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); show(); }
      });
    })();
  </script>
</body>
</html>
